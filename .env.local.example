# ─── AI JOURNALIST STUDIO — Environment Variables ────────────────
# Copy this file to .env.local and fill in your keys

# Groq — interview brain (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Deepgram — STT only (Nova-3)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia — TTS (Sonic) journalist voices
CARTESIA_API_KEY=sk_car_your_cartesia_api_key_here

# Anam — live video journalist faces (SERVER-SIDE ONLY, never NEXT_PUBLIC_)
# Minted server-side in /api/anam/session; the key never reaches the browser.
# The key was exposed in chat in the past: ROTATE it in Anam Lab
# (lab.anam.ai -> API Keys) before pasting a fresh one here.
ANAM_API_KEY=your_anam_api_key_here

# ElevenLabs — TTS (legacy, kept for fallback)
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# ─── D-ID Live Video Journalist (optional but HIGHLY recommended) ─
# Sign up at https://studio.d-id.com
# Create an Agent → click [...] → Embed → copy these two values
# MUST be prefixed NEXT_PUBLIC_ so they're available client-side
NEXT_PUBLIC_DID_CLIENT_KEY=your_did_client_key_here
NEXT_PUBLIC_DID_AGENT_ID=agt_xxxxxxxxxxxx

# ─── Notes ───────────────────────────────────────────────────────
# Without video keys: studio uses animated SVG avatar + Cartesia TTS voice
# With Anam keys:     studio shows a live Anam avatar face that lip-syncs
#                     the Cartesia voice (audio passthrough) — the live-video path.
# With D-ID keys:     D-ID is the legacy fallback for journalists without
#                     an Anam avatar (WebRTC stream).
# D-ID free tier: 10 mins/month streaming. Paid from $5.99/mo.
# HeyGen is also supported — replace VideoJournalist.tsx with HeyGen SDK
