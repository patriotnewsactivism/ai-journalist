# ─── AI JOURNALIST STUDIO — Environment Variables ────────────────
# Copy this file to .env.local and fill in your keys

# Groq — interview brain (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Deepgram — STT only (Nova-3)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs — TTS (eleven_turbo_v2_5) journalist voices
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# ─── D-ID Live Video Journalist (optional but HIGHLY recommended) ─
# Sign up at https://studio.d-id.com
# Create an Agent → click [...] → Embed → copy these two values
# MUST be prefixed NEXT_PUBLIC_ so they're available client-side
NEXT_PUBLIC_DID_CLIENT_KEY=your_did_client_key_here
NEXT_PUBLIC_DID_AGENT_ID=agt_xxxxxxxxxxxx

# ─── Notes ───────────────────────────────────────────────────────
# Without D-ID keys: studio uses animated SVG avatar + ElevenLabs TTS voice
# With D-ID keys:    studio shows real talking video journalist (WebRTC stream)
# D-ID free tier: 10 mins/month streaming. Paid from $5.99/mo.
# HeyGen is also supported — replace VideoJournalist.tsx with HeyGen SDK
